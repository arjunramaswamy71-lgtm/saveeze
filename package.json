{
  "name": "saveeze",
  "description": "See if a store is charging you more than everyone else.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build --mode e2e && playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.19.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arjunramaswamy71-lgtm/saveeze"
  },
  "author": "Arjun Ramaswamy"
}
